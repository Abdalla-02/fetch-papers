# Copy this file to ".env" (in the data folder you run the script from, or next to fetch_pdfs.py)
# and fill in the keys you have. ".env" is in .gitignore - never commit it, never share it.
# Leave a line empty or delete it if you don't have that key; the source is then skipped.

# Elsevier Article Retrieval API - key from https://dev.elsevier.com
ELSEVIER_API_KEY=
# Institutional token from the university library (needed outside the campus network)
ELSEVIER_INSTTOKEN=

# Wiley TDM API - token from Wiley Online Library (TDM terms accepted)
WILEY_TDM_TOKEN=
